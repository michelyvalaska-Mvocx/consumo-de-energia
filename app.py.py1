print("=== Calculadora de Consumo Eletrico ===")
aparelho = input("Nome do aparelho: ")
potencia = float(input("Potencia em watts: "))
horas = float(input("Horas por dia: "))

consumo = (potencia * horas * 30) / 1000
custo = consumo * 0.75

print(f"\nAparelho: {aparelho}")
print(f"Consumo estimado: {consumo:.2f} kWh/mes")
print(f"Custo estimado: R$ {custo:.2f}")